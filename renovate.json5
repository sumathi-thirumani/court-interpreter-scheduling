{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Repository-specific Renovate config. Extends the shared bcgov/renovate-config preset. Downstream repos should reference this file for consistent update management.",
  "extends": [
    "github>bcgov/renovate-config#2026.8.18"
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Regenerate npm lockfiles consistently",
      "matchManagers": [
        "npm"
      ],
      "postUpdateOptions": [
        "npmInstallTwice"
      ]
    },
    {
      "description": "Vue CLI ecosystem",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@vue/cli-plugin-babel",
        "@vue/cli-plugin-eslint",
        "@vue/cli-plugin-router",
        "@vue/cli-plugin-typescript",
        "@vue/cli-plugin-vuex",
        "@vue/cli-service"
      ],
      "groupName": "Vue CLI",
      "groupSlug": "vue-cli"
    },
    {
      "description": "Vue core ecosystem",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vue",
        "vue-template-compiler",
        "vue-router",
        "vuex",
        "vuex-class",
        "vuex-module-decorators",
        "vue-class-component",
        "vue-property-decorator"
      ],
      "groupName": "Vue core",
      "groupSlug": "vue-core"
    },
    {
      "description": "Vue plugins",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vue-axios",
        "vue-cookies",
        "vue-resource",
        "vue-fontawesome",
        "vue-fontawesome-icon",
        "vue-cli-plugin-vuetify",
        "vuetify"
      ],
      "groupName": "Vue plugins",
      "groupSlug": "vue-plugins"
    },
    {
      "description": "ESLint and TypeScript linting",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-vue",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "@vue/eslint-config-typescript"
      ],
      "groupName": "ESLint and TypeScript linting",
      "groupSlug": "eslint-typescript"
    },
    {
      "description": "TypeScript tooling",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript",
        "ts-loader"
      ],
      "groupName": "TypeScript",
      "groupSlug": "typescript"
    },
    {
      "description": "Jest tooling",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "jest",
        "@types/jest",
        "ts-jest"
      ],
      "groupName": "Jest",
      "groupSlug": "jest"
    },
    {
      "description": "Sass tooling",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "sass",
        "sass-loader"
      ],
      "groupName": "Sass",
      "groupSlug": "sass"
    },
    {
      "description": "Bootstrap ecosystem",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "bootstrap",
        "bootstrap-vue",
        "@bcgov/bootstrap-theme"
      ],
      "groupName": "Bootstrap",
      "groupSlug": "bootstrap"
    },
    {
      "description": "Axios ecosystem",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "axios",
        "axios-auth-refresh",
        "vue-axios"
      ],
      "groupName": "Axios",
      "groupSlug": "axios"
    },
    {
      "description": "FastAPI ecosystem",
      "matchManagers": [
        "pip-compile"
      ],
      "matchPackageNames": [
        "fastapi",
        "starlette",
        "pydantic",
        "pydantic-core",
        "annotated-doc",
        "annotated-types",
        "typing-inspection",
        "anyio"
      ],
      "groupName": "FastAPI",
      "groupSlug": "python-fastapi"
    },
    {
      "description": "Python database ecosystem",
      "matchManagers": [
        "pip-compile"
      ],
      "matchPackageNames": [
        "sqlalchemy",
        "alembic",
        "fastapi-sqlalchemy",
        "psycopg2-binary",
        "greenlet",
        "mako",
        "markupsafe"
      ],
      "groupName": "Python database",
      "groupSlug": "python-database"
    },
    {
      "description": "Python authentication and cryptography",
      "matchManagers": [
        "pip-compile"
      ],
      "matchPackageNames": [
        "cryptography",
        "bcrypt",
        "pynacl",
        "passlib",
        "pyjwt",
        "python-jose",
        "ecdsa",
        "rsa",
        "pyasn1",
        "cffi",
        "pycparser"
      ],
      "groupName": "Python authentication and cryptography",
      "groupSlug": "python-auth-crypto"
    },
    {
      "description": "Python HTTP ecosystem",
      "matchManagers": [
        "pip-compile"
      ],
      "matchPackageNames": [
        "requests",
        "urllib3",
        "certifi",
        "charset-normalizer",
        "idna"
      ],
      "groupName": "Python HTTP",
      "groupSlug": "python-http"
    },
    {
      "description": "Python ASGI server",
      "matchManagers": [
        "pip-compile"
      ],
      "matchPackageNames": [
        "uvicorn",
        "h11"
      ],
      "groupName": "Uvicorn",
      "groupSlug": "python-uvicorn"
    },
    {
      "description": "Python data processing",
      "matchManagers": [
        "pip-compile"
      ],
      "matchPackageNames": [
        "pandas",
        "numpy",
        "openpyxl",
        "et-xmlfile",
        "python-dateutil",
        "pytz",
        "tzdata"
      ],
      "groupName": "Python data processing",
      "groupSlug": "python-data"
    },
    {
      "description": "Python testing",
      "matchManagers": [
        "pip-compile"
      ],
      "matchPackageNames": [
        "pytest",
        "pluggy",
        "iniconfig",
        "packaging",
        "pygments",
        "colorama",
        "exceptiongroup",
        "tomli"
      ],
      "groupName": "Python testing",
      "groupSlug": "python-testing"
    },
    {
      "matchPackageNames": [
        "@typescript-eslint/eslint-plugin"
      ],
      "allowedVersions": ">=4.13.0 <5"
    },
    {
      "matchPackageNames": [
        "@typescript-eslint/parser"
      ],
      "allowedVersions": ">=8.71.1 <9"
    },
    {
      "matchPackageNames": [
        "@vue/cli-plugin-babel"
      ],
      "allowedVersions": ">=5.0.9 <6"
    },
    {
      "matchPackageNames": [
        "@vue/cli-plugin-eslint"
      ],
      "allowedVersions": ">=5.0.9 <6"
    },
    {
      "matchPackageNames": [
        "@vue/cli-plugin-router"
      ],
      "allowedVersions": ">=5.0.9 <6"
    },
    {
      "matchPackageNames": [
        "@vue/cli-plugin-typescript"
      ],
      "allowedVersions": ">=5.0.9 <6"
    },
    {
      "matchPackageNames": [
        "@vue/cli-service"
      ],
      "allowedVersions": ">=5.0.9 <6"
    },
    {
      "matchPackageNames": [
        "@vue/eslint-config-typescript"
      ],
      "allowedVersions": ">=14.9.0 <15"
    },
    {
      "matchPackageNames": [
        "axios"
      ],
      "allowedVersions": ">=0.34.0 <1"
    },
    {
      "matchPackageNames": [
        "bootstrap-vue"
      ],
      "allowedVersions": ">=2.23.1 <3"
    },
    {
      "matchPackageNames": [
        "eslint"
      ],
      "allowedVersions": ">=6.8.0 <7"
    },
    {
      "matchPackageNames": [
        "eslint-plugin-vue"
      ],
      "allowedVersions": ">=10.11.1 <11"
    },
    {
      "matchPackageNames": [
        "fastapi"
      ],
      "allowedVersions": ">=0.133.0 <1"
    },
    {
      "matchPackageNames": [
        "jest"
      ],
      "allowedVersions": ">=30.5.2 <31"
    },
    {
      "matchPackageNames": [
        "moment-timezone"
      ],
      "allowedVersions": ">=0.5.35 <1"
    },
    {
      "matchPackageNames": [
        "node-sass"
      ],
      "allowedVersions": ">=7.0.3 <8"
    },
    {
      "matchPackageNames": [
        "raw-loader"
      ],
      "allowedVersions": ">=4.0.2 <5"
    },
    {
      "matchPackageNames": [
        "sass"
      ],
      "allowedVersions": ">=1.105.1 <2"
    },
    {
      "matchPackageNames": [
        "sass-loader"
      ],
      "allowedVersions": ">=17.0.1 <18"
    },
    {
      "matchPackageNames": [
        "save"
      ],
      "allowedVersions": ">=2.9.0 <3"
    },
    {
      "matchPackageNames": [
        "showdown"
      ],
      "allowedVersions": ">=2.1.0 <3"
    },
    {
      "matchPackageNames": [
        "ts-jest"
      ],
      "allowedVersions": ">=29.4.6 <30"
    },
    {
      "matchPackageNames": [
        "ts-loader"
      ],
      "allowedVersions": ">=9.6.2 <10"
    },
    {
      "matchPackageNames": [
        "underscore"
      ],
      "allowedVersions": ">=1.13.8 <2"
    },
    {
      "matchPackageNames": [
        "vue"
      ],
      "allowedVersions": ">=3.5.43 <4"
    },
    {
      "matchPackageNames": [
        "vue-cli-plugin-vuetify"
      ],
      "allowedVersions": ">=2.5.8 <3"
    },
    {
      "matchPackageNames": [
        "vue-fontawesome-icon"
      ],
      "allowedVersions": ">=1.3.2 <2"
    },
    {
      "matchPackageNames": [
        "vue-resource"
      ],
      "allowedVersions": ">=1.5.3 <2"
    },
    {
      "matchPackageNames": [
        "vuetify"
      ],
      "allowedVersions": ">=3.0.0a10 <4"
    }
  ]
}
